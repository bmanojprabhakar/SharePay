{
  "name": "sharepay-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@sharepay/web",
    "dev:mobile": "npm run start --workspace=@sharepay/mobile",
    "build:web": "npm run build --workspace=@sharepay/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspace=@sharepay/web",
    "clean": "rm -rf node_modules packages/*/node_modules",
    "install:all": "npm install && npm install --workspaces"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
