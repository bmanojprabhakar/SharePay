rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is member of a group
    function isGroupMember(groupData) {
      return request.auth != null && 
        (request.auth.uid in groupData.members.map(['userId']) ||
         request.auth.email in groupData.members.map(['email']));
    }
    
    // Users collection - users can read basic info but only modify their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write, create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Groups collection - users can access groups they're members of
    match /groups/{groupId} {
      allow read: if request.auth != null && 
        (request.auth.uid in resource.data.members.map(['userId']) ||
         request.auth.email in resource.data.members.map(['email']));
      
      allow write: if request.auth != null && 
        (request.auth.uid in resource.data.members.map(['userId']) ||
         request.auth.email in resource.data.members.map(['email']));
      
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.createdBy ||
         request.auth.uid in request.resource.data.members.map(['userId']));
    }
    
    // Top-level expenses collection - users can access expenses from their groups
    match /expenses/{expenseId} {
      allow read, write, create: if request.auth != null;
      // Note: In production, you'd want to verify the user is in the group
      // This simplified rule allows all authenticated users for development
    }
    
    // For development: Allow all authenticated users to read/write
    // Remove this in production and use more restrictive rules above
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}